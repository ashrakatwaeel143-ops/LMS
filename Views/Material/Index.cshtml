@model List<LmsProject.Models.Material>

@{
    ViewData["Title"] = "Materials";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Materials</h2>
    <a href="/Material/Create" class="btn btn-primary">+ Add Material</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Title</th>
            <th>Course</th>
            <th>Link</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Title</td>
                <td>@m.Course?.Title</td>
                <td><a href="@m.FileUrl" target="_blank">Open</a></td>
            </tr>
        }
    </tbody>
</table>